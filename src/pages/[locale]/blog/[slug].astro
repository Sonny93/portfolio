---
import { render, type CollectionEntry } from 'astro:content';

import { getPublishedPosts } from '../../../lib/posts';
import JsonLd from '../../../components/seo/json_ld.astro';
import PostLayout from '../../../layouts/post_layout.astro';
import { formatPublishedDate } from '../../../lib/format_date';
import { buildArticleSchema } from '../../../lib/structured_data';
import SectionTitle from '../../../components/section_title.astro';
import ArticleMeta from '../../../components/seo/article_meta.astro';
import { estimateReadingTimeMinutes } from '../../../lib/reading_time';
import { resolveOpenGraphImagePath } from '../../../lib/open_graph_image';
import { LOCALES, resolveLocale, useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
	const postsByLocale = await Promise.all(
		LOCALES.map(async (locale) => ({
			locale,
			posts: await getPublishedPosts(locale),
		}))
	);
	return postsByLocale.flatMap(({ locale, posts }) =>
		posts.map((post) => ({
			params: { locale, slug: post.data.urlSlug },
			props: { post },
		}))
	);
}

type Props = {
	post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const translate = useTranslations(locale);

const { Content } = await render(post);
const publishedAtLabel = formatPublishedDate(post.data.publishedAt, locale);
const estimatedReadTime = estimateReadingTimeMinutes(post.body ?? '');
const readTimeLabel = `${estimatedReadTime} ${translate('post.readTimeUnit')}`;

const articleSchema =
	Astro.site === undefined
		? undefined
		: buildArticleSchema({
				siteUrl: Astro.site,
				articleUrl: new URL(Astro.url.pathname, Astro.site).toString(),
				headline: post.data.title,
				description: post.data.description,
				publishedAt: post.data.publishedAt,
				tags: post.data.tags,
				imageUrl: new URL(
					resolveOpenGraphImagePath(locale, undefined),
					Astro.site
				).toString(),
				locale,
			});
---

<PostLayout
	title={post.data.title}
	description={post.data.description}
	openGraphType="article"
>
	<Fragment slot="head">
		<ArticleMeta publishedAt={post.data.publishedAt} tags={post.data.tags} />
		{articleSchema !== undefined && <JsonLd schema={articleSchema} />}
	</Fragment>
	<SectionTitle title={post.data.title} level="h1" />
	<div class="flex items-center gap-4 text-sm text-gray-400">
		{publishedAtLabel} &middot; {readTimeLabel}
	</div>
	<div class="prose prose-invert min-w-full">
		<Content />
	</div>
</PostLayout>
