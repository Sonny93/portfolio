---
import { render, type CollectionEntry } from 'astro:content';

import { ROUTES } from '../../../constants/routes';
import { getPublishedPosts } from '../../../lib/posts';
import { localizedUrl } from '../../../lib/localized_url';
import JsonLd from '../../../components/seo/json_ld.astro';
import PageLayout from '../../../layouts/page_layout.astro';
import { formatPublishedDate } from '../../../lib/format_date';
import SectionTitle from '../../../components/section_title.astro';
import ArticleMeta from '../../../components/seo/article_meta.astro';
import { estimateReadingTimeMinutes } from '../../../lib/reading_time';
import Breadcrumb from '../../../components/navigation/breadcrumb.astro';
import { LOCALES, resolveLocale, useTranslations } from '../../../i18n/ui';
import { readGeneratedOgImageNames } from '../../../../scripts/read_generated_og_image_names';
import {
	resolveOpenGraphImagePath,
	resolvePostOpenGraphImagePath,
} from '../../../lib/open_graph_image';
import {
	buildArticleSchema,
	buildBreadcrumbSchema,
	type BreadcrumbTrailItem,
	type JsonLdSchema,
} from '../../../lib/structured_data';

export async function getStaticPaths() {
	const [postsByLocale, generatedImageNames] = await Promise.all([
		Promise.all(
			LOCALES.map(async (locale) => ({
				locale,
				posts: await getPublishedPosts(locale),
			}))
		),
		readGeneratedOgImageNames(),
	]);
	return postsByLocale.flatMap(({ locale, posts }) =>
		posts.map((post) => ({
			params: { locale, slug: post.data.urlSlug },
			props: {
				post,
				openGraphImagePath: resolvePostOpenGraphImagePath(
					locale,
					post.data.urlSlug,
					generatedImageNames
				),
			},
		}))
	);
}

type Props = {
	post: CollectionEntry<'posts'>;
	openGraphImagePath: string | undefined;
};

const { post, openGraphImagePath } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const translate = useTranslations(locale);

const META_SEPARATOR = ' · ';

const { publishedAt, updatedAt } = post.data;
const { Content } = await render(post);
const publishedAtLabel = formatPublishedDate(publishedAt, locale);
const updatedAtLabel =
	updatedAt === undefined || updatedAt.getTime() === publishedAt.getTime()
		? undefined
		: `${translate('post.updatedOn')} ${formatPublishedDate(updatedAt, locale)}`;
const estimatedReadTime = estimateReadingTimeMinutes(post.body ?? '');
const readTimeLabel = `${estimatedReadTime} ${translate('post.readTimeUnit')}`;
const metaLine = [publishedAtLabel, updatedAtLabel, readTimeLabel]
	.filter((segment) => segment !== undefined)
	.join(META_SEPARATOR);

const breadcrumbTrail: readonly BreadcrumbTrailItem[] = [
	{
		kind: 'ancestor',
		name: translate('navigation.home'),
		url: localizedUrl(locale, ROUTES.home),
	},
	{
		kind: 'ancestor',
		name: translate('navigation.blog'),
		url: localizedUrl(locale, ROUTES.blog),
	},
	{ kind: 'current', name: post.data.title },
];

function buildStructuredData(siteUrl: URL): readonly JsonLdSchema[] {
	return [
		buildArticleSchema({
			siteUrl,
			articleUrl: new URL(Astro.url.pathname, siteUrl).toString(),
			headline: post.data.title,
			description: post.data.description,
			publishedAt,
			updatedAt,
			tags: post.data.tags,
			imageUrl: new URL(
				resolveOpenGraphImagePath(locale, openGraphImagePath),
				siteUrl
			).toString(),
			locale,
		}),
		buildBreadcrumbSchema(breadcrumbTrail, siteUrl),
	];
}

const structuredDataSchemas =
	Astro.site === undefined ? [] : buildStructuredData(Astro.site);
---

<PageLayout
	title={post.data.title}
	description={post.data.description}
	openGraphType="article"
	contentFlow="article"
	image={openGraphImagePath}
>
	<Fragment slot="head">
		<ArticleMeta
			publishedAt={post.data.publishedAt}
			updatedAt={post.data.updatedAt}
			tags={post.data.tags}
		/>
		{structuredDataSchemas.map((schema) => <JsonLd schema={schema} />)}
	</Fragment>
	<Breadcrumb trail={breadcrumbTrail} />
	<SectionTitle title={post.data.title} level="h1" />
	<div class="flex items-center gap-4 text-sm text-gray-400">{metaLine}</div>
	<div class="prose prose-invert min-w-full">
		<Content />
	</div>
</PageLayout>
