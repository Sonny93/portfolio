---
import clsx from 'clsx';

import BaseLayout from './base_layout.astro';
import type { OpenGraphType } from './base_layout.astro';
import Footer from '../components/navigation/footer.astro';
import Navbar from '../components/navigation/navbar.astro';

type ContentFlow = 'sections' | 'article';

type Props = {
	title: string;
	description?: string;
	openGraphType?: OpenGraphType;
	image?: string;
	imageAlt?: string;
	contentFlow?: ContentFlow;
};

const CONTENT_GAP_BY_FLOW: Record<ContentFlow, string> = {
	sections: 'gap-16 sm:gap-20',
	article: 'gap-4',
};

const {
	title,
	description,
	openGraphType,
	image,
	imageAlt,
	contentFlow = 'sections',
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description}
	openGraphType={openGraphType}
	image={image}
	imageAlt={imageAlt}
>
	<slot name="head" slot="head" />
	<div class="relative z-1 flex min-h-dvh flex-col">
		<div class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-6 p-4">
			<Navbar />
			<main
				id="main-content"
				tabindex="-1"
				class={clsx(
					'flex flex-col py-10 sm:py-16',
					CONTENT_GAP_BY_FLOW[contentFlow]
				)}
				data-page-transition
			>
				<slot />
			</main>
			<Footer />
		</div>
	</div>
</BaseLayout>
